import std;
import net.column;
fn main() {
    let nether=registry263::vanilla("minecraft:the_nether");assert(nether.min_y==0 && nether.height==256 && nether.has_ceiling && !nether.has_skylight);
    assert(registry263::valid_shape(-2032,4064) && !registry263::valid_shape(0,2147483632));
    let first=configuration263::RegistryData {registry:"minecraft:dimension_type",entries:[configuration263::RegistryEntry {id:"minecraft:the_nether"}]};
    let last=configuration263::RegistryData {registry:"minecraft:dimension_type",entries:[configuration263::RegistryEntry {id:"minecraft:the_end"}]};
    let records:configuration263::RegistryData[]=[copy(first),copy(last)];
    let dimensions,e=registry263::dimensions(records);assert(wire::is_ok(e) && dimensions.len==1 && dimensions[0].ambient_light==0.25);
    assert(registry263::dimension(dimensions,-1).min_y== -64 && registry263::dimension(dimensions,2).height==384);
    let layout=registry263::Layout {min_y:-32,height:32,logical_height:32};
    let chunk=chunk_wire::ChunkData {buffer:[0,1,0,0,0,4,0,7,0,1,0,0,0,5,0,8]};
    let light=chunk_wire::LightData {};
    let column,ce=column263::bind(-12,8,chunk,light,layout,16,4);assert(wire::is_ok(ce));
    assert(column.sections.len==2 && column.light.len==4 && column.x== -12 && column.z==8);
    let a,aa=column263::block_at(column,0,-32,0);let b,bb=column263::block_at(column,15,-17,15);let c,cc=column263::block_at(column,15,-1,15);
    assert(aa && bb && cc && a==4 && b==4 && c==5);
    let biome,found=column263::biome_at(column,15,-1,15);assert(found && biome==8);
    let outside,valid=column263::block_at(column,0,-33,0);assert(!valid);
    let outside2,valid2=column263::block_at(column,16,-32,0);assert(!valid2);
    let outside3,valid3=column263::block_at(column,0,0,0);assert(!valid3);
    let short=chunk_wire::ChunkData {buffer:[0,1,0,0,0,4,0,7]};
    let failed,error=column263::bind(0,0,short,light,layout,16,4);assert(!wire::is_ok(error));
    var values:i32[4096]=[0;4096];values[561]=9;
    var biomes:i32[64]=[0;64];biomes[45]=11;
    let states=chunk_wire::from_values(values,true,16);let bios=chunk_wire::from_values(biomes,false,4);
    let section=chunk_wire::Section {non_empty:1,states:copy(states),biomes:copy(bios)};
    let sections:chunk_wire::Section[]=[copy(section)];let bytes=chunk_wire::from_sections(sections);
    let patterned=chunk_wire::ChunkData {buffer:bytes[..]};
    let one=registry263::Layout {min_y:-16,height:16,logical_height:16};
    let detailed,de=column263::bind(0,0,patterned,light,one,16,4);assert(wire::is_ok(de));
    let selected,ok=column263::block_at(detailed,1,-14,3);assert(ok && selected==9);
    let adjacent,ok2=column263::block_at(detailed,3,-14,1);assert(ok2 && adjacent==0);
    let selected_biome,ok3=column263::biome_at(detailed,4,-8,12);assert(ok3 && selected_biome==11);
    let removed=configuration263::RegistryData {registry:"minecraft:dimension_type"};
    let empty_records:configuration263::RegistryData[]=[copy(first),copy(removed)];
    let empty,ee=registry263::dimensions(empty_records);assert(wire::is_ok(ee) && empty.len==0);
    print("Registry replacement, dimension bounds and resident column coordinates passed.");
}
