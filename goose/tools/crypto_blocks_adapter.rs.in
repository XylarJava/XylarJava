// Oracle-only AES dependency adaptation. Cfb8/MD5/UUID bodies stay in the
// pinned source; the unavailable Cargo AES implementation becomes OpenSSL.
pub const LANES: usize = 32;
#[repr(C)] struct Input { data: *const u8, len: i64 }
#[repr(C)] struct Output { data: *mut u8, len: i64 }
unsafe extern "C" {
    fn gx_aes_open(key: Input) -> u64;
    fn gx_aes_close(handle: u64);
    fn gx_aes_blocks(handle: u64, input: Input, output: Output) -> i32;
}
pub struct Aes128 { handle: u64, key: [u8; 16] }
impl Clone for Aes128 { fn clone(&self) -> Self { Self::new(&self.key) } }
impl Drop for Aes128 { fn drop(&mut self) { unsafe { gx_aes_close(self.handle) }; } }
impl Aes128 {
    pub fn new(key: &[u8; 16]) -> Self {
        let handle = unsafe { gx_aes_open(Input { data: key.as_ptr(), len: 16 }) };
        assert_ne!(handle, 0);
        Self { handle, key: *key }
    }
    fn blocks(&self, data: &mut [u8]) {
        let n = data.len() as i64;
        assert_eq!(unsafe { gx_aes_blocks(self.handle, Input { data: data.as_ptr(), len: n },
                                         Output { data: data.as_mut_ptr(), len: n }) }, 1);
    }
    pub fn cfb8_encrypt(&self, register: &mut [u8; 16], data: &mut [u8]) {
        for b in data {
            let mut block = *register;
            self.blocks(&mut block);
            *b ^= block[0];
            register.copy_within(1.., 0);
            register[15] = *b;
        }
    }
    pub fn encrypt_lanes(&self, data: &mut [[u8; 16]; LANES]) {
        let flat = unsafe { std::slice::from_raw_parts_mut(data.as_mut_ptr().cast(), LANES * 16) };
        self.blocks(flat);
    }
}
