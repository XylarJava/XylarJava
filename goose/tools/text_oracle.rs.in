// Development oracle, using the original source module without edits.
#[path = "@TEXT_SOURCE@"]
mod text;
use std::io::{self, Read};
fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    for line in input.lines() {
        assert_eq!(line.len() % 2, 0);
        let bytes: Vec<u8> = (0..line.len()).step_by(2)
            .map(|i| u8::from_str_radix(&line[i..i+2], 16).unwrap()).collect();
        match std::str::from_utf8(&bytes).ok().and_then(text::parse_java_integer) {
            Some(value) => println!("OK {value}"),
            None => println!("NONE"),
        }
    }
}
