// Test-only flate2-shaped adapter to the system-zlib bridge. This does NOT
// validate the upstream zlib-rs backend or its compressed byte choices.
extern crate self as flate2;
#[repr(C)] struct ZInput { data: *const u8, len: i64 }
#[repr(C)] struct ZOutput { data: *mut u8, len: i64 }
unsafe extern "C" {
    fn gx_zlib_bound(length: i64) -> i64;
    fn gx_deflate(input: ZInput, output: ZOutput, written: *mut i64) -> i32;
    fn gx_inflater_open() -> u64;
    fn gx_inflater_close(handle: u64);
    fn gx_inflate(handle: u64, input: ZInput, output: ZOutput, written: *mut i64) -> i32;
}
#[derive(Default)] pub struct Compression;
pub enum FlushDecompress { Finish }
pub enum Status { Ok, StreamEnd, BufError }
#[derive(Debug)] pub struct DecompressError(i32);
impl std::fmt::Display for DecompressError {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result { write!(f, "zlib status {}", self.0) }
}
pub struct Decompress { handle: u64 }
impl Decompress {
    pub fn new(zlib_header: bool) -> Self {
        assert!(zlib_header);
        let handle = unsafe { gx_inflater_open() };
        assert_ne!(handle, 0);
        Self { handle }
    }
    pub fn reset(&mut self, zlib_header: bool) { assert!(zlib_header); }
    pub fn decompress_vec(&mut self, input: &[u8], out: &mut Vec<u8>, _: FlushDecompress) -> std::result::Result<Status, DecompressError> {
        assert!(out.is_empty());
        out.resize(out.capacity(), 0);
        let mut written = 0;
        let code = unsafe { gx_inflate(self.handle, ZInput { data: input.as_ptr(), len: input.len() as i64 },
            ZOutput { data: out.as_mut_ptr(), len: out.len() as i64 }, &mut written) };
        out.truncate(written as usize);
        match code { 0 => Ok(Status::Ok), 1 => Ok(Status::StreamEnd), -5 => Ok(Status::BufError), _ => Err(DecompressError(code)) }
    }
}
impl Drop for Decompress { fn drop(&mut self) { unsafe { gx_inflater_close(self.handle); } } }
pub mod write {
    pub struct ZlibEncoder<W> { writer: W, input: Vec<u8> }
    impl<W: std::io::Write> ZlibEncoder<W> {
        pub fn new(writer: W, _: super::Compression) -> Self { Self { writer, input: vec![] } }
        pub fn finish(mut self) -> std::io::Result<W> {
            let capacity = unsafe { super::gx_zlib_bound(self.input.len() as i64) };
            assert!(capacity >= 0);
            let mut output = vec![0; capacity as usize];
            let mut written = 0;
            let code = unsafe { super::gx_deflate(super::ZInput { data: self.input.as_ptr(), len: self.input.len() as i64 },
                super::ZOutput { data: output.as_mut_ptr(), len: capacity }, &mut written) };
            if code != 0 { return Err(std::io::Error::other(format!("zlib compression status {code}"))); }
            self.writer.write_all(&output[..written as usize])?;
            Ok(self.writer)
        }
    }
    impl<W: std::io::Write> std::io::Write for ZlibEncoder<W> {
        fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> { self.input.extend_from_slice(bytes); Ok(bytes.len()) }
        fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
    }
}
